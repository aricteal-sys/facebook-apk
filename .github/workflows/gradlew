#!/bin/sh

#
# Gradle start up script for UNIX
#

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

DIRNAME=`dirname "$0"`
APP_HOME=`cd "$DIRNAME"; pwd`

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

exec java $JAVA_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
